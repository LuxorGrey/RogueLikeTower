    "damage_tags": ["PHYSICAL", "FIRE", "ARCANE"],
    "armor_formula": "min(raw_damage, armor * packet_armor_multiplier)",
    "health_formula": "floor(max(raw_damage - armor_absorbed, 0) * target_tag_multiplier * packet_health_multiplier)",
    "regeneration": "fractional_hp_per_second_capped_at_max_health",
    "regen_counter_strength_range": [0.0, 1.0],
    "regen_counter_duration_seconds_provisional": 1.25,
