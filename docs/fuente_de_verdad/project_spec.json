    "straight",
    "gentle_turn",
    "hard_turn",
    "fork",
    "convergence"
  ],
  "terrain_piece_placement": {
    "requires_unique_cells": true,
    "requires_connected_footprint": true,
    "requires_board_edge_adjacency": true,
    "internal_path_edges_are_reciprocal": true,
    "external_path_edges_allow_lateral_flexible_sockets": true,
    "expansion_path_edges_require_complementary_socket": true,
    "expansion_requires_existing_path_connection": true,
    "global_spawn_to_base_route_validation_milestone": "M4"
