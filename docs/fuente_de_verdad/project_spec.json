  "terrain_preview_elevation_pixel_offset": 18,
  "terrain_preview_colors": {
    "PATH": "#59666E",
    "GRASS": "#479157",
    "MOUNTAIN": "#A1947A"
  },
  "terrain_preview_hover_colors": {
    "PATH": "#82BFE6",
    "GRASS": "#80E085",
    "MOUNTAIN": "#F5C25C"
  },
