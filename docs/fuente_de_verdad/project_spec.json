    "ROUND_PREP",
    "COMBAT",
    "ROUND_REWARD",
    "TERRAIN_EXPANSION",
    "CARD_OFFER",
    "ROUND_TRANSITION",
    "RUN_VICTORY",
    "RUN_DEFEAT"
  ]
