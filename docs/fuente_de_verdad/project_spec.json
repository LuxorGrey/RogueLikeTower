  "map_navigation": {
    "pan": "middle_mouse_drag",
    "zoom": "mouse_wheel_at_cursor",
    "zoom_min": 0.45,
    "zoom_max": 2.5,
    "toggle_hud_key": "H",
    "recenter_key": "R",
    "hud_layer": "CanvasLayer"
