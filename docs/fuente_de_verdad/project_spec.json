    "allowed_terrain": ["GRASS", "MOUNTAIN"],
    "buildable_phases": ["ROUND_PREP", "COMBAT", "TERRAIN_EXPANSION"],
    "targeting_modes": ["FIRST_PROGRESS", "LAST_PROGRESS", "HIGHEST_HEALTH", "HIGHEST_ARMOR"],
    "target_scan_interval_seconds": 0.1,
    "attack": "hitscan_through_scene_local_damage_service",
    "height_range_bonus_per_elevation_level_provisional": 0.25,
    "upgrade_max_level": 3,
