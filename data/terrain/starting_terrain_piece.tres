[gd_resource type="Resource" script_class="TerrainPieceData" load_steps=10 format=3]

[ext_resource type="Script" path="res://game/board/terrain_piece_cell_data.gd" id="1_cell"]
[ext_resource type="Script" path="res://game/board/terrain_piece_data.gd" id="2_piece"]

[sub_resource type="Resource" id="TerrainPieceCell_path_center"]
script = ExtResource("1_cell")
local_coord = Vector2i(0, 0)
terrain_type = 0
elevation = 0
path_edges = 16

[sub_resource type="Resource" id="TerrainPieceCell_path_northwest"]
script = ExtResource("1_cell")
local_coord = Vector2i(0, -1)
terrain_type = 0
elevation = 0
path_edges = 2

[sub_resource type="Resource" id="TerrainPieceCell_grass_northeast"]
script = ExtResource("1_cell")
local_coord = Vector2i(1, -1)
terrain_type = 1
elevation = 1

[sub_resource type="Resource" id="TerrainPieceCell_grass_east"]
script = ExtResource("1_cell")
local_coord = Vector2i(1, 0)
terrain_type = 1
elevation = 1

[sub_resource type="Resource" id="TerrainPieceCell_mountain_southeast"]
script = ExtResource("1_cell")
local_coord = Vector2i(0, 1)
terrain_type = 2
elevation = 2

[sub_resource type="Resource" id="TerrainPieceCell_grass_southwest"]
script = ExtResource("1_cell")
local_coord = Vector2i(-1, 1)
terrain_type = 1
elevation = 1

[sub_resource type="Resource" id="TerrainPieceCell_mountain_west"]
script = ExtResource("1_cell")
local_coord = Vector2i(-1, 0)
terrain_type = 2
elevation = 2

[resource]
script = ExtResource("2_piece")
id = &"starting_7_hex"
display_name = "Loseta inicial de 7 hexágonos"
cells = Array[ExtResource("1_cell")]([SubResource("TerrainPieceCell_path_center"), SubResource("TerrainPieceCell_path_northwest"), SubResource("TerrainPieceCell_grass_northeast"), SubResource("TerrainPieceCell_grass_east"), SubResource("TerrainPieceCell_mountain_southeast"), SubResource("TerrainPieceCell_grass_southwest"), SubResource("TerrainPieceCell_mountain_west")])
